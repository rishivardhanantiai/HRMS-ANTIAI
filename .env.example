# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=change-this-to-a-long-random-string

DATABASE_URL=postgresql://user:password@host:5432/dbname

SUPABASE_URL=
SUPABASE_KEY=
SERVICE_KEY=
SUPABASE_RESUME_BUCKET=resumes

# ===== Self-service onboarding emails (free — Gmail SMTP) =====
# 1. Turn on 2-Step Verification on the antiai.hr@gmail.com Google account.
# 2. Google Account -> Security -> App Passwords -> generate one for "Mail".
# 3. Paste the 16-character app password below (NOT the normal Gmail password).
EMAIL_ADDRESS=antiai.hr@gmail.com
EMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=Anti AI HR Team
COMPANY_NAME=Anti AI

# Where "new onboarding submission" notifications go. Defaults to EMAIL_ADDRESS.
HR_NOTIFY_EMAIL=antiai.hr@gmail.com

# Set to 1 only when deployed on Vercel (switches upload paths to /tmp)
VERCEL=
